# All optional. Libria works with no configuration.

# Identify your deployment to Open Library (they ask API clients to send a descriptive User-Agent with contact info).
# LIBRIA_USER_AGENT="Libria/0.1 (https://your-site.example; you@example.com)"

# Optional dedicated quota for the Google Books fallback. Read server-side only, never sent to the browser.
# GOOGLE_BOOKS_API_KEY=

# Semantic similarity runs a local, free sentence-transformer on the server (downloaded once into .cache/transformers).
# Set to "off" to score with metadata only. Any Hugging Face feature-extraction model with ONNX weights works.
# LIBRIA_EMBEDDINGS=auto
# LIBRIA_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Where the model files and the embedding cache live (relative to the project root).
# LIBRIA_CACHE_DIR=.cache

# Rehearse the "library is quiet" experience locally.
# LIBRIA_SIMULATE_OUTAGE=1
